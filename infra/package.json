{
  "name": "@waddles/infra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "synth": "cdk synth --strict",
    "bootstrap": "cdk bootstrap",
    "setup": "pnpm run bootstrap && pnpm run identity:deploy",
    "site:diff": "cdk diff WaddlesSiteStack",
    "site:deploy": "cdk deploy WaddlesSiteStack",
    "preview:diff": "cdk diff WaddlesPreviewStack",
    "preview:deploy": "cdk deploy WaddlesPreviewStack",
    "domain:deploy": "cdk deploy WaddlesDomainStack",
    "identity:deploy": "cdk deploy WaddlesIdentityStack",
    "deploy": "pnpm site:deploy"
  },
  "dependencies": {
    "aws-cdk-lib": "2.262.0",
    "constructs": "10.7.1"
  },
  "devDependencies": {
    "@types/aws-cloudfront-function": "1.0.8",
    "@types/node": "26.1.1",
    "@waddles/config-typescript": "workspace:*",
    "@waddles/www": "workspace:*",
    "aws-cdk": "2.1132.0",
    "typescript": "7.0.2"
  }
}
