{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "synth": {
      "dependsOn": ["^build", "build"],
      "outputs": ["cdk.out/**"]
    },
    "deploy": {
      "dependsOn": ["^build", "build"],
      "cache": false
    }
  }
}
